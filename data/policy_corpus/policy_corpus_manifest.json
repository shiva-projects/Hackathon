    },
    "pl-001-v30-chunk-002": {
      "chunk_id": "pl-001-v30-chunk-002",
      "policy_id": "PL-001",
      "version": "v3.0",
      "source_file": "data/policy_corpus/PL_retail_personal_loan_v3.md",
      "text_hash": "ff72946fc79b9d3e8950a68d419d63240a801edc1dc62d90cdedd9b427b3117d",
      "text": "## Section 1: Overview\nUpcoming personal lending framework scheduled to become effective on January 1, 2027."
    },
    "chunk-dti-v3-001": {
      "chunk_id": "chunk-dti-v3-001",
      "policy_id": "PL-001",
      "version": "v3.0",
      "source_file": "data/policy_corpus/PL_retail_personal_loan_v3.md",
      "text_hash": "e423111a77d001af190136d8ccb1762e2b05f7859b0bae2d60a598f8dd65fa25",
      "text": "## Section 2: Expanded Affordability Limits (Chunk: chunk-dti-v3-001)\nUnder forward policy Rule PL-07-v3, the maximum permitted Debt-to-Income (DTI) ratio is expanded to 45.0% (0.45) for eligible applicants with higher disposable income buffers."
    },
