      "text_hash": "bec1fd76fbec53df3750a411a7634e8c77be8c550569e19f37049bfcbcf28860",
      "text": "## Section 1: Scope\nStandards governing residential mortgage originations across the United Kingdom for 2026."
    },
    "chunk-uk-mort-001": {
      "chunk_id": "chunk-uk-mort-001",
      "policy_id": "PL-MORT-UK-01",
      "version": "v1.0",
      "source_file": "data/policy_corpus/UK_mortgage_policy_v1.md",
      "text_hash": "b9e20d66ad9c10fd44762ea04ad082537dc9063a9cb00ac638c5cd71fe1bf162",
      "text": "## Section 2: Affordability Criteria (Chunk: chunk-uk-mort-001)\nUnder Rule UK-MORT-01, the maximum total debt service ratio must not exceed 35.0% of verified sterling gross income. A certified property valuation report is strictly required."
    }
