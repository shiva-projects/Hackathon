# Google Gemini API configuration (Primary LLM provider)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# optional fallback — used only if GEMINI_API_KEY is unset or exhausted
GROQ_API_KEY=

# Phoenix Observability
PHOENIX_PORT=6006
PHOENIX_PROJECT_NAME=loan-copilot

# Application settings
LOG_LEVEL=INFO
