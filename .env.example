# Optional LLM Provider Override (default: resolution_order in config/model_config.json: gemini -> groq)
# LLM_PROVIDER=gemini

# Primary Provider: Google Gemini API (Recommended / Default)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.7-flash

# Fallback Provider: Groq API (Secondary Resilience)
GROQ_API_KEY=

# Phoenix Observability
PHOENIX_PORT=6006
PHOENIX_PROJECT_NAME=loan-copilot

# Application settings
LOG_LEVEL=INFO
